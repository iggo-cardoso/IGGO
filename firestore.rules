rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthorized() {
      return request.auth != null
          && request.auth.uid == 'kUWkLZeloeZa6uvsarCelTi5rwe2';
    }
    match /snapshots/{snapshotId} {
      allow read, write: if isAuthorized();
    }
    match /statusLog/{logId} {
      allow read, write: if isAuthorized();
    }
    match /clientes/{clienteId} {
      allow read, write: if isAuthorized();
      match /comunicacoes/{comId} { allow read, write: if isAuthorized(); }
      match /reunioes/{reuniaoId} { allow read, write: if isAuthorized(); }
      match /projetos/{projetoId} {
        allow read, write: if isAuthorized();
        match /pagamentos/{pagId}   { allow read, write: if isAuthorized(); }
        match /pendencias/{penId}   { allow read, write: if isAuthorized(); }
        match /docs/{docId}         { allow read, write: if isAuthorized(); }
        match /comunicacoes/{comId} { allow read, write: if isAuthorized(); }
      }
      match /pagamentos/{pagId}  { allow read, write: if isAuthorized(); }
      match /pendencias/{penId}  { allow read, write: if isAuthorized(); }
      match /docs/{docId}        { allow read, write: if isAuthorized(); }
      match /servicos/{serId}    { allow read, write: if isAuthorized(); }
      match /emails/{emailId}    { allow read, write: if isAuthorized(); }
    }
    match /emails/{emailId} {
      allow read, write: if isAuthorized();
    }
    match /reunioes/{reuniaoId} {
      allow read, write: if isAuthorized();
    }
    match /ferramentas/{ferramentaId} {
      allow read, write: if isAuthorized();
    }
    match /dominios/{dominioId} {
      allow read, write: if isAuthorized();
    }
    match /kanbanBoards/{boardId} {
      allow read, write: if isAuthorized();
      match /lists/{listId} { allow read, write: if isAuthorized(); }
      match /cards/{cardId} { allow read, write: if isAuthorized(); }
    }
    match /tributario/{competencia} {
      allow read, write: if isAuthorized();
    }
    match /{document=**} {
      allow read, write: if false;
    }
    match /inscricoesLoja/{id} {
      allow read, update, delete: if isAuthorized();
      allow create: if false;
    }
    match /afiliacoes/{id} {
      allow read, update, delete: if isAuthorized();
      allow create: if false;
    }
    match /contatos/{id} {
      allow read, update, delete: if isAuthorized();
      allow create: if false;
    }
    match /briefings/{id} {
      allow read, update, delete: if isAuthorized();
      allow create: if false;
    }
  }
}
